# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (фото инспектора)
BLOB_READ_WRITE_TOKEN=

# Защита POST /api/seed (заголовок x-seed-secret)
SEED_SECRET=

# Несекретное: имя бота без @ (для ссылки в панели)
NEXT_PUBLIC_BOT_USERNAME=
